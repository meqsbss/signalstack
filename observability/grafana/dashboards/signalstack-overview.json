{
  "uid": "signalstack-overview",
  "title": "SignalStack | Application Observability",
  "tags": ["signalstack", "opentelemetry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {"id":1,"type":"stat","title":"API requests / sec","gridPos":{"h":4,"w":6,"x":0,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(signalstack_http_requests_total[5m]))","legendFormat":"req/s"}]},
    {"id":2,"type":"stat","title":"5xx error rate","gridPos":{"h":4,"w":6,"x":6,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(rate(signalstack_http_requests_total{http_response_status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(signalstack_http_requests_total[5m])), 0.001) * 100","legendFormat":"error %"}],"fieldConfig":{"defaults":{"unit":"percent"}}},
    {"id":3,"type":"stat","title":"Competitor refreshes (1h)","gridPos":{"h":4,"w":6,"x":12,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(signalstack_competitor_refreshes_total[1h]))","legendFormat":"refreshes"}]},
    {"id":4,"type":"stat","title":"Detected changes (24h)","gridPos":{"h":4,"w":6,"x":18,"y":0},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(signalstack_change_events_total[24h]))","legendFormat":"events"}]},
    {"id":5,"type":"timeseries","title":"HTTP request rate by route","gridPos":{"h":8,"w":12,"x":0,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum by (http_route) (rate(signalstack_http_requests_total[5m]))","legendFormat":"{{http_route}}"}]},
    {"id":6,"type":"timeseries","title":"HTTP latency p95","gridPos":{"h":8,"w":12,"x":12,"y":4},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"histogram_quantile(0.95, sum by (le) (rate(signalstack_http_request_duration_seconds_bucket[5m])))","legendFormat":"p95"}],"fieldConfig":{"defaults":{"unit":"s"}}},
    {"id":7,"type":"timeseries","title":"Competitor refresh failures","gridPos":{"h":8,"w":12,"x":0,"y":12},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"expr":"sum(increase(signalstack_refresh_failures_total[5m]))","legendFormat":"failures"}]},
    {"id":8,"type":"logs","title":"Application logs","gridPos":{"h":8,"w":12,"x":12,"y":12},"datasource":{"type":"loki","uid":"loki"},"targets":[{"expr":"{service_name=\"signalstack-api-dev\"}"}]}
  ],
  "annotations": {"list": []}
}
